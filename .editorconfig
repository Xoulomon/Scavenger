# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# 4-space indentation for Rust
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 120

# 2-space indentation for Markdown
[*.md]
indent_style = space
indent_size = 2
max_line_length = 80

# 2-space indentation for YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 4-space indentation for JSON
[*.json]
indent_style = space
indent_size = 4

# 4-space indentation for CSS
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# 2-space indentation for JavaScript/TypeScript
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# 2-space indentation for Python
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# 2-space indentation for HTML
[*.{html,htm}]
indent_style = space
indent_size = 2

# 2-space indentation for XML
[*.xml]
indent_style = space
indent_size = 2

# 2-space indentation for TOML
[*.toml]
indent_style = space
indent_size = 4

# 2-space indentation for Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# 2-space indentation for Dockerfile
[ Dockerfile]
indent_style = space
indent_size = 2
