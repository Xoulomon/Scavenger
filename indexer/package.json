{
  "name": "scavngr-indexer",
  "version": "1.0.0",
  "description": "Stellar contract event indexer for Scavngr",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern='tests/(?!integration|migration)'",
    "test:integration": "jest --runInBand --testPathPattern='tests/integration'",
    "test:migrations": "jest --runInBand --testPathPattern='tests/migration'",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@scavngr/types": "workspace:*",
    "@stellar/stellar-sdk": "13.1.0",
    "pg": "8.13.3",
    "dotenv": "16.4.7",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@types/pg": "8.11.11",
    "@types/redis": "2.8.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "jest": "29.7.0",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts"],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "moduleNameMapper": {
      "^../src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
