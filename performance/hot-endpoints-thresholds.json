  "load_scenarios": {
    "steady_state_100": {
      "description": "Normal operational load: 100 concurrent users",
      "users": 100,
      "ramp_up_minutes": 2,
      "sustain_minutes": 5,
      "ramp_down_minutes": 2,
      "total_duration_minutes": 9,
      "expected_rps": 150,
      "acceptable_error_rate_pct": 5,
      "acceptable_p95_ms": 500
    },
    "spike_1000": {
      "description": "Traffic spike: sudden increase to 1000 concurrent users",
      "users": 1000,
      "ramp_up_minutes": 0.5,
      "sustain_minutes": 2,
      "ramp_down_minutes": 0.5,
      "total_duration_minutes": 5,
      "expected_rps": 1500,
      "acceptable_error_rate_pct": 10,
      "acceptable_p95_ms": 1000
    },
    "stress_10000": {
      "description": "Stress test: gradual increase to 10000 concurrent users",
      "users": 10000,
      "ramp_up_minutes": 6,
      "sustain_minutes": 5,
      "ramp_down_minutes": 2,
      "total_duration_minutes": 13,
      "expected_rps": 15000,
      "acceptable_error_rate_pct": 20,
      "acceptable_p95_ms": 2000
    }
  },
  "notes": [
    "All thresholds are in milliseconds unless otherwise specified",
    "Baseline values represent expected performance under normal conditions",
    "Warning thresholds indicate degraded performance but acceptable operation",
    "Critical thresholds indicate performance that requires investigation",
    "Hot endpoints are identified based on expected production traffic patterns",
    "Read-heavy endpoints prioritized for load testing due to higher concurrent usage",
    "Write operations tested at moderate load due to lower concurrency and idempotency requirements"
  ]
